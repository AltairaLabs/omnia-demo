# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor / IDE
.vscode/
.idea/
*.swp
*~
.claude/

# Environment / secrets
.env
.env.local
*.pem
*.key

# Build artifacts (if any future tooling generates them)
dist/
build/
out/
tmp/

# Git worktrees (local isolated workspaces)
.worktrees/

# Local drafts / scratch
scratch/
notes/
*.draft.*

# Compiled PromptPack JSON from markdown sources (generated during Helm chart build)
**/*.compiled.json

# Your Omnia install's inputs (deploy/azure/site.example.yaml is the template)
deploy/azure/site.yaml

# The last `make images` dev build (Makefile)
.images.env

# A test-only site file holding a deployment's real values, for the render
# comparison in deploy/azure (TestRenderedTenantsUnchanged). Never commit it.
deploy/azure/testdata/site-ours.yaml
